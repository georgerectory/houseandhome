{
  "name": "houseandhome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "House manager: renovation roadmap, prioritised backlog, savings allocation, floor plan, inventory and equipment register. Zero-build static site served from GitHub Pages; this package.json exists only for dev tooling and tests, and the site itself ships no node_modules.",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "test": "node tools/run-all-tests.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:geometry": "node tools/check-geometry.mjs",
    "test:sql": "bash tools/run-sql-tests.sh",
    "test:parity": "node tools/parity-check.mjs",
    "test:frontend": "node tools/check-frontend.mjs",
    "lint": "node tools/lint-frontend.mjs",
    "test:secrets": "node tools/check-secrets.mjs",
    "screenshots": "node tools/check-frontend.mjs --screenshots",
    "fixtures": "node tools/build-fixtures.mjs",
    "pages": "node tools/build-pages.mjs"
  },
  "devDependencies": {
    "playwright": "1.49.1"
  }
}
